    "file-type": "^22.0.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "mermaid": "^11.17.2",
    "next": "16.1.2",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
