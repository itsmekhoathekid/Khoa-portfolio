{
  "name": "khoa-cli-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:seed": "tsx scripts/seed-admin.ts",
    "admin:seed:generated": "tsx scripts/seed-admin.ts --generate-password",
    "content:seed": "tsx scripts/seed-content.ts",
    "assets:gc": "tsx scripts/gc-assets.ts",
    "test:storage:init": "tsx scripts/create-test-bucket.ts",
    "content:migrate": "tsx scripts/migrate-content.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
