# Neon PostgreSQL (pooled connection string)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional local development fallback; leave unset when using Neon.
DATABASE_DRIVER=

# Better Auth — use at least 32 random bytes in production
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 S3-compatible API
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=khoa-portfolio-media-prod
# Same-origin proxy backed by the private bucket. Use an absolute MinIO URL only locally.
NEXT_PUBLIC_MEDIA_URL=/media
# Set only for local S3-compatible stores such as MinIO; leave unset for R2.
R2_FORCE_PATH_STYLE=

# Used only by `pnpm admin:seed`; never expose these as NEXT_PUBLIC_ variables
ADMIN_USERNAME=anhkhoa
ADMIN_EMAIL=admin@example.com
# Supply ADMIN_PASSWORD only in the one-time seed process environment.

# Used only by `pnpm content:migrate`; do not configure these in Vercel.
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
SOURCE_R2_ENDPOINT=
SOURCE_R2_ACCESS_KEY_ID=
SOURCE_R2_SECRET_ACCESS_KEY=
SOURCE_R2_BUCKET=
SOURCE_R2_FORCE_PATH_STYLE=true
TARGET_R2_ENDPOINT=
TARGET_R2_ACCESS_KEY_ID=
TARGET_R2_SECRET_ACCESS_KEY=
TARGET_R2_BUCKET=khoa-portfolio-media-prod
